# Copy this file to .env and fill in both values. .env is gitignored.
# SEC requires a contact name and email on every request.
SEC_USER_AGENT=
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Optional. "mock" uses invented data for testing the UI; leave blank for real data.
DATA_MODE=
